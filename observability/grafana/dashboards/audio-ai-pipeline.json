{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "tags": ["platform-core", "audio", "ai", "pipeline"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "title": "Audio AI Pipeline",
  "uid": "audio-ai-pipeline",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pipeline Completed (5m rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(pipeline_jobs_completed_total[5m]))" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "STT DLQ Depth",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.stt-dlq\"})" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM DLQ Depth",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.llm-dlq\"})" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TTS DLQ Depth",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.tts-dlq\"})" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Stage Throughput (jobs/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(stt_jobs_total[5m]))", "legendFormat": "STT" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(llm_jobs_total[5m]))", "legendFormat": "LLM" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(tts_jobs_total[5m]))", "legendFormat": "TTS" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(pipeline_jobs_completed_total[5m]))", "legendFormat": "Pipeline Completed" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stage Latency p95 (s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(stt_job_duration_seconds_bucket[5m])) by (le))", "legendFormat": "STT p95" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "LLM p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(tts_generation_duration_seconds_bucket[5m])) by (le))", "legendFormat": "TTS p95" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "End-to-End Latency p50 / p95 (s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(pipeline_end_to_end_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(pipeline_end_to_end_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka Consumer Lag by Topic",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.jobs\"}) by (topic)", "legendFormat": "audio.jobs" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.transcripts\"}) by (topic)", "legendFormat": "audio.transcripts" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.summaries\"}) by (topic)", "legendFormat": "audio.summaries" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pipeline Failure Rate by Stage (jobs/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(pipeline_jobs_failed_total[5m])) by (stage)", "legendFormat": "{{stage}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DLQ Depths Over Time",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.stt-dlq\"})", "legendFormat": "STT DLQ" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.llm-dlq\"})", "legendFormat": "LLM DLQ" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kafka_consumergroup_lag{topic=\"audio.tts-dlq\"})", "legendFormat": "TTS DLQ" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker Replica Counts (KEDA)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kube_deployment_status_replicas{deployment=\"stt-worker\"})", "legendFormat": "stt-worker" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kube_deployment_status_replicas{deployment=\"llm-worker\"})", "legendFormat": "llm-worker" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(kube_deployment_status_replicas{deployment=\"tts-worker\"})", "legendFormat": "tts-worker" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "LLM Tokens Generated (tokens/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(llm_tokens_generated_total[5m]))", "legendFormat": "tokens/s" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Queue Wait p95 by Stage (s)",
      "description": "Seconds a job waited between creation (audio-api) and each worker starting to process it — pipeline_queue_wait_seconds, computed as now - event created_at. Works on local kind and prod.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(pipeline_queue_wait_seconds_bucket[5m])) by (le, stage))", "legendFormat": "{{stage}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU Utilization % (prod)",
      "description": "Per-GPU utilization from the DCGM exporter (DCGM_FI_DEV_GPU_UTIL), plus vLLM KV-cache occupancy. PROD/EKS ONLY — local kind has no GPU, so this panel shows \"No data\" there by design.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(DCGM_FI_DEV_GPU_UTIL) by (pod)", "legendFormat": "{{pod}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(vllm:gpu_cache_usage_perc) * 100", "legendFormat": "vLLM KV-cache" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Transcript Size p50 / p95 (bytes)",
      "description": "Size of the transcript written to object storage by stt-worker (stt_transcript_bytes).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(stt_transcript_bytes_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(stt_transcript_bytes_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Summary Size p50 / p95 (bytes)",
      "description": "Size of the summary JSON written to object storage by llm-worker (llm_summary_bytes).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(llm_summary_bytes_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(llm_summary_bytes_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Audio Services Cost ($/hr)",
      "description": "OpenCost-derived hourly cost (CPU + RAM allocation × node hourly rate) for the four audio-pipeline workloads in the apps namespace. Dev/kind shows low costs; prod reflects GPU node rates when STT/TTS scale up.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(container_cpu_allocation{namespace=\"apps\", pod=~\"(audio-api|stt-worker|llm-worker|tts-worker)-.*\"} * on(node) group_left() node_cpu_hourly_cost) + sum(container_memory_allocation_bytes{namespace=\"apps\", pod=~\"(audio-api|stt-worker|llm-worker|tts-worker)-.*\"} / 1024 / 1024 / 1024 * on(node) group_left() node_ram_hourly_cost)", "legendFormat": "audio services $/hr" }
      ]
    }
  ]
}
