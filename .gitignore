# Terraform
.terraform/
# .terraform.lock.hcl is intentionally NOT excluded — lock files must be
# committed so terraform init is reproducible across developers and CI.
*.tfplan
*.tfstate
*.tfstate.backup
terraform.tfvars        # contains real values — use terraform.tfvars.example

# Secrets
*.pem
*.key
kubeconfig
.env

# Python (apps + tests)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Helm
charts/
*.tgz

# kind
kind-config.yaml.backup
